# Legacy direct environment mapping. The recommended Windows flow is:
# 1. Run .\set-llm-key.ps1 and paste the key into the secure prompt.
# 2. Review config\llm.runtime.json (it contains no secret).
# 3. Run .\start-with-llm.ps1.
#
# The launcher maps MEDICAL_RESUME_LLM_API_KEY into these process-only names.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
