  "restricted_verbs": ["负责", "主导", "管理", "领导", "独立完成", "统筹", "拥有"],
  "forbidden_claims": ["独立中心监查", "研究中心生命周期所有权", "受试者招募所有权", "预算所有权", "项目或项目群所有权", "PI、赞助方或外部沟通所有权", "团队管理", "确保合规"],
  "required_evidence": {"owned_component": ["specific_task", "research_artifact", "scope_of_responsibility"], "led_delivery": ["monitoring_assignment", "site_visit_evidence", "accountability_evidence"], "project_owner": ["scope_ownership_evidence", "decision_authority", "delivery_accountability"]},
  "sentence_patterns": ["协助{object}的{action}与{deliverable}维护，支持{purpose}", "参与{scope}的{action}，跟进{constraint}并支持{purpose}", "整理{object}并与{team}沟通既定{timeline}"],
