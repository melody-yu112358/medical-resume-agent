    {"input":{"case_id":"cra-negative","case_type":"negative","persona_id":"cra-p5","jd_ids":["cra-07","cra-10"],"facts":["细胞培养","qPCR实验"],"non_claims":["CRA经历","临床研究流程"]},"expected_output":["现有实验室研究事实不足以支持CRA或临床研究执行经历。"]}
