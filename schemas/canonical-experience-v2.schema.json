{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/canonical-experience-v2.schema.json",
  "title": "Canonical Medical Experience Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experience_id", "evidence_ids", "context", "role", "actions", "methods", "tools", "techniques", "objects", "collaboration", "artifacts", "outcomes", "scope", "unknowns", "activities", "task_responsibilities", "status"],
  "properties": {
    "schema_version": {"const": "canonical-experience-v2"},
    "experience_id": {"type": "string"},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "context": {"type": "object"},
    "role": {"type": "object", "required": ["responsibility_level"]},
    "actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "methods": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "techniques": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "objects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "collaboration": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "artifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "outcomes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "scope": {"type": "object"}, "unknowns": {"type": "array", "items": {"type": "string"}},
    "identity": {"$ref": "#/$defs/identity"},
    "activities": {"type": "array", "items": {"$ref": "#/$defs/activity"}, "uniqueItems": true},
    "task_responsibilities": {"type": "array", "items": {"$ref": "#/$defs/responsibility"}, "uniqueItems": true},
    "status": {"const": "user_confirmed"}
  },
  "$defs": {
    "period": {"type": "object", "additionalProperties": false, "required": ["start", "end", "ongoing"], "properties": {"start": {"type": ["string", "null"]}, "end": {"type": ["string", "null"]}, "ongoing": {"type": "boolean"}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["project_name", "organization", "role_title", "period", "evidence_ids"], "properties": {"project_name": {"type": "string", "minLength": 1}, "organization": {"type": ["string", "null"]}, "role_title": {"type": ["string", "null"]}, "period": {"$ref": "#/$defs/period"}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}}},
    "components": {"type": "object", "additionalProperties": false, "required": ["actions", "methods", "tools", "techniques", "objects", "artifacts"], "properties": {"actions": {"type": "array", "items": {"type": "string"}}, "methods": {"type": "array", "items": {"type": "string"}}, "tools": {"type": "array", "items": {"type": "string"}}, "techniques": {"type": "array", "items": {"type": "string"}}, "objects": {"type": "array", "items": {"type": "string"}}, "artifacts": {"type": "array", "items": {"type": "string"}}}},
    "activity": {"type": "object", "additionalProperties": false, "required": ["activity_id", "label", "components", "evidence_ids", "status"], "properties": {"activity_id": {"type": "string"}, "label": {"type": "string"}, "components": {"$ref": "#/$defs/components"}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "status": {"const": "user_confirmed"}}},
    "responsibility": {"type": "object", "additionalProperties": false, "required": ["responsibility_id", "activity_id", "ownership_level", "execution_mode", "scope", "evidence_ids"], "properties": {"responsibility_id": {"type": "string"}, "activity_id": {"type": "string"}, "ownership_level": {"enum": ["contributed", "owned_component", "led_delivery", "accountable"]}, "execution_mode": {"enum": ["supervised", "independent", "shared"]}, "scope": {"type": "object", "additionalProperties": false, "required": ["coverage", "note"], "properties": {"coverage": {"enum": ["full", "partial"]}, "note": {"type": ["string", "null"]}}}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}
  }
}
