{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/career-card-explanation-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "profile_type", "scenario_note", "evidence"],
  "properties": {
    "profile_id": { "type": "string", "pattern": "^synthetic-[a-z0-9-]+$" },
    "profile_type": { "const": "synthetic" },
    "scenario_note": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "statement", "capability_codes", "scope", "evidence_status"],
        "properties": {
          "evidence_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "capability_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } },
          "scope": { "enum": ["assigned_support", "supervised_training", "academic_exercise", "independent_nonclinical"] },
          "evidence_status": { "const": "confirmed" }
        }
      }
    }
  }
}
