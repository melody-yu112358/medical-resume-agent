{
  "schema_version": "medical-resume-workflow-v1",
  "stages": [
    {"id": "intake", "label": "材料输入", "progress": 0},
    {"id": "fact_confirmation", "label": "事实确认", "progress": 20},
    {"id": "representative_sample", "label": "样例确认", "progress": 40},
    {"id": "composition", "label": "完整生成", "progress": 65},
    {"id": "factual_audit", "label": "事实审计", "progress": 85},
    {"id": "delivery", "label": "编辑导出", "progress": 100}
  ],
  "targets": [
    {"id": "doctoral", "label": "学术升学与科研申请", "role_pack": "doctoral_v1"},
    {"id": "clinical_research", "label": "临床研究与医院科研", "role_pack": "clinical_research_v1"},
    {"id": "clinical_operations", "label": "临床运营 / 临床项目协调", "role_pack": "clinical_operations_v1"},
    {"id": "medical_affairs", "label": "医学事务 / MSL", "role_pack": "medical_affairs_v1"},
    {"id": "health_data", "label": "医疗数据与数字健康", "role_pack": "health_ai_data_v1"}
  ],
  "themes": [
    {"id": "clinical-blue", "label": "临床蓝"},
    {"id": "academic-green", "label": "学术绿"},
    {"id": "ats-mono", "label": "ATS 黑白"}
  ],
  "actions": [
    "create_conversation",
    "answer_candidate_profile",
